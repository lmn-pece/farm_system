<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.farm_system.mapper.RoleMapper">

    <!-- 根据角色Id查询权限Id列表 -->
    <select id="selectRolePermissionIds" resultType="java.lang.Long">
        SELECT permission_id FROM sys_role_permission WHERE role_id = #{roleId}
    </select>


    <!-- 根据角色Id列表删除角色与权限关联 -->
    <delete id="deleteRolePermissionByRoleIds">
        DELETE FROM sys_role_permission WHERE role_id IN
        <foreach item="roleId" collection="roleIds" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </delete>

    <!-- 批量插入角色与权限关联 -->
    <insert id="insertRolePermissions">
        INSERT INTO sys_role_permission (role_id,permission_id)
        VALUES
        <foreach item="permissionId" collection="permissionIds" separator=",">
            (#{roleId},#{permissionId})
        </foreach>
    </insert>

    <!-- 根据角色Id列表删除用户与角色关联 -->
    <delete id="deleteUserRolesByRoleIds">
        DELETE FROM sys_user_role WHERE role_id IN
        <foreach item="roleId" collection="roleIds" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </delete>

    <!-- 根据角色Id查询权用户Id列表 -->
    <select id="selectRoleUserIds" resultType="java.lang.Long">
        SELECT user_id FROM sys_user_role WHERE role_id = #{roleId}
    </select>


    <!-- 根据角色Id和用户Id列表删除用户与角色关联 -->
    <delete id="deleteRoleUserByRoleIdAndUserIds">
        DELETE FROM sys_user_role WHERE role_id = #{roleId} AND user_id IN
        <foreach item="userId" collection="userIds" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </delete>

    <!-- 检查用户与角色之间是否存在关联 -->
    <select id="countUserRoleExists" resultType="int">
        SELECT COUNT(*) FROM sys_user_role WHERE role_id = #{roleId} AND user_id = #{userId}
    </select>

    <!-- 插入用户角色关联 -->
    <insert id="insertUserRole">
        INSERT INTO sys_user_role (user_id,role_id) VALUES (#{userId},#{roleId})
    </insert>




</mapper>