# 复制本文件为 .env 后按实际环境修改（.env 不会被提交到 Git）

# ===== 数据库 =====
DB_URL=jdbc:mysql:///farm?serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_password

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== JWT =====
# 请替换为足够长的随机字符串
JWT_SECRET=please-change-this-to-a-long-random-secret
JWT_EXPIRATION=604800
